{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kameleon": "Data Source=kameleon-demo.db"
  },
  "Kameleon": {
    "FallbackThemeId": "aurora",
    "DefaultThemeId": "aurora",
    "AllowUserOverride": true,
    "EnabledThemes": [ "aurora", "atlas", "harbour" ]
  }
}
