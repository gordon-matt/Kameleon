<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>SQL Server storage for the Kameleon theme engine.</Description>
		<PackageTags>themes;theme-engine;entity-framework-core;efcore;sqlserver;mssql</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kameleon.Data\Kameleon.Data.csproj" />
	</ItemGroup>

</Project>
