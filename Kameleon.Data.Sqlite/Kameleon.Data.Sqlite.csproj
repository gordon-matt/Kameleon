<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>SQLite storage for the Kameleon theme engine.</Description>
		<PackageTags>themes;theme-engine;entity-framework-core;efcore;sqlite</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<!--
		  Microsoft.Data.Sqlite brings in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries advisory
		  GHSA-2m69-gcr7-jv3q. The bundle and native library are pinned to patched releases.
		-->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kameleon.Data\Kameleon.Data.csproj" />
	</ItemGroup>

</Project>
