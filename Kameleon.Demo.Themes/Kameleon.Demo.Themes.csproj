<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<Description>Two sample compiled themes for the Kameleon demo.</Description>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Sass sources for wwwroot/bootstrap; only the compiled output ships. -->
		<Compile Remove="Styles\**" />
		<Content Remove="Styles\**" />
		<EmbeddedResource Remove="Styles\**" />
		<None Remove="Styles\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kameleon.Abstractions\Kameleon.Abstractions.csproj" />
	</ItemGroup>

</Project>
